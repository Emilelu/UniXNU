# iOS/iPadOS 16.6.1 (20G81) kernel switches.
# The K60 payload carries no trust cache yet and mounts no mock filesystem, so the
# runtime trust cache and the mockfs sources stay off; the prelinked kernel brings
# its own corecrypto.
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
